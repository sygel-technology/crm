<odoo>
    <record id="transfer_portfolio_wizard_form" model="ir.ui.view">
        <field name="name">transfer.portfolio.wizard.form</field>
        <field name="model">transfer.portfolio.wizard</field>
        <field name="arch" type="xml">
            <form string="Transfer Portfolio">
                <field name="review_state" invisible="1"/>
                <group>
                    <group>
                        <field class="text-break" name="current_salesperson" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}" attrs="{'readonly': [('review_state', '=', True)]}"/>
                    </group>
                    <group>
                        <field class="text-break" name="new_salesperson" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                    </group>
                </group>
                <notebook attrs="{'invisible': [('review_state', '=', False)]}">
                    <page string="Contacts">
                        <field name="contact_ids">
                            <tree string="Contacts" create="0" delete="0">
                                <field name="name"/>
                            </tree>
                        </field>
                    </page>
                    <page string="Opportunities">
                        <field name="opportunity_ids">
                            <tree string="Opportunities" create="0" delete="0">
                                <field name="name"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button string="Review" name="review_transfer" type="object" class="btn-primary" attrs="{'invisible': [('review_state', '=', True)]}"/>
                    <button string="Transfer" name="transfer_portfolio" type="object" class="btn-primary" attrs="{'invisible': [('review_state', '=', False)]}"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_transfer_portfolio" model="ir.actions.act_window">
        <field name="name">Transfer Portfolio</field>
        <field name="res_model">transfer.portfolio.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="crm_portfolio_transfer.transfer_portfolio_wizard_form" />
        <field name="target">new</field>
    </record>

    <menuitem
        id="transfer_client_portfolio_menu"
        name="Transfer Client Portfolio"
        parent="crm.crm_menu_sales"
        action="crm_portfolio_transfer.action_transfer_portfolio"
        sequence="5"/>
</odoo>
