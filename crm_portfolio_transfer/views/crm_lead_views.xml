<odoo>
    <record id="crm_portfolio_transfer_crm_lead_view_form" model="ir.ui.view">
        <field name="name">crm.portfolio.transfer.crm.lead.view.form</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position='after'>
                <field name="previous_salesperson_id" attrs="{'invisible': [('previous_salesperson_id', '=', False)]}"/>
            </xpath>
        </field>
    </record>
</odoo>
